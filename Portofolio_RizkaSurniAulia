<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rizka Surni Aulia — Portfolio</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=Plus+Jakarta+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --green: #3D5A47;
    --green-light: #4E7260;
    --green-dark: #2C4235;
    --pink: #F2D9D9;
    --pink-dark: #E8C4C4;
    --cream: #FAF5F0;
    --text: #1E2E25;
    --text-muted: #5A7265;
    --white: #FFFFFF;
    --gold: #C8A96E;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    background: var(--cream);
    color: var(--text);
    overflow-x: hidden;
  }

  /* ── NAV ── */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 999;
    background: var(--green);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 2.5rem;
    padding: 1rem 2rem;
    box-shadow: 0 2px 20px rgba(0,0,0,0.15);
  }

  nav a {
    color: var(--white);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    padding: 0.4rem 1rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
    cursor: pointer;
  }

  nav a:hover,
  nav a.active {
    background: rgba(255,255,255,0.18);
    color: var(--white);
  }

  /* ── HERO ── */
  #home {
    min-height: 100vh;
    background: var(--green);
    display: flex;
    align-items: center;
    padding: 6rem 6rem 4rem;
    position: relative;
    overflow: hidden;
  }

  #home::before {
    content: '';
    position: absolute;
    top: -80px; right: -80px;
    width: 500px; height: 500px;
    border-radius: 50%;
    background: var(--pink);
    opacity: 0.12;
  }

  .hero-content {
    flex: 1;
    z-index: 1;
    animation: fadeUp 0.8s ease both;
  }

  .hero-greeting {
    font-size: 1rem;
    color: rgba(255,255,255,0.65);
    margin-bottom: 0.5rem;
    letter-spacing: 0.08em;
  }

  .hero-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.8rem, 6vw, 4.5rem);
    font-weight: 900;
    color: var(--white);
    line-height: 1.05;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
    margin-bottom: 2.5rem;
    font-weight: 300;
  }

  .hero-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    background: var(--pink);
    color: var(--green-dark);
    padding: 0.75rem 2rem;
    border-radius: 2rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: pointer;
    border: none;
    display: inline-block;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.2);
  }

  .btn-outline {
    background: transparent;
    color: var(--white);
    padding: 0.75rem 2rem;
    border-radius: 2rem;
    font-weight: 500;
    font-size: 0.9rem;
    text-decoration: none;
    border: 1.5px solid rgba(255,255,255,0.4);
    transition: border-color 0.2s, background 0.2s;
    cursor: pointer;
    display: inline-block;
  }

  .btn-outline:hover {
    border-color: var(--white);
    background: rgba(255,255,255,0.08);
  }

  .hero-photo {
    flex-shrink: 0;
    width: 280px;
    height: 320px;
    border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
    background: var(--pink);
    overflow: hidden;
    margin-left: 4rem;
    border: 4px solid rgba(255,255,255,0.15);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    animation: fadeUp 0.8s 0.2s ease both;
    position: relative;
    z-index: 1;
  }

  .hero-photo-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--green);
    opacity: 0.5;
    font-size: 0.8rem;
    text-align: center;
    padding: 1rem;
  }

  .hero-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  /* bottom ticker */
  .hero-ticker {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: var(--pink);
    padding: 0.85rem 2rem;
    display: flex;
    justify-content: center;
    gap: 3rem;
  }

  .hero-ticker span {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--green);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* ── ABOUT ── */
  #about {
    background: var(--green);
    padding: 6rem 6rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 700;
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .section-title .accent {
    color: var(--gold);
  }

  #about .section-title { color: var(--white); }

  .about-desc {
    text-align: center;
    color: rgba(255,255,255,0.7);
    font-size: 1rem;
    line-height: 1.8;
    max-width: 520px;
    margin: 0 auto 1rem;
  }

  .about-sub {
    text-align: center;
    color: rgba(255,255,255,0.5);
    font-size: 0.9rem;
    margin-bottom: 3.5rem;
  }

  .skills-title {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    color: var(--white);
    text-align: center;
    margin-bottom: 2rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 520px;
    margin: 0 auto;
  }

  .skill-pill {
    background: var(--pink);
    color: var(--green-dark);
    padding: 0.9rem 1.5rem;
    border-radius: 2rem;
    font-weight: 600;
    font-size: 0.9rem;
    text-align: center;
    transition: transform 0.2s, box-shadow 0.2s;
    cursor: default;
  }

  .skill-pill:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.15);
  }

  /* ── PORTFOLIO ── */
  #portfolio {
    background: var(--pink);
    padding: 6rem 6rem;
    min-height: 100vh;
  }

  #portfolio .section-title { color: var(--green); }
  #portfolio .section-title .accent { color: var(--green-light); font-style: italic; }

  .portfolio-layout {
    display: flex;
    gap: 3rem;
    align-items: flex-start;
    max-width: 900px;
    margin: 0 auto;
  }

  .portfolio-filter {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.5rem;
  }

  .filter-btn {
    background: none;
    border: none;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--text-muted);
    cursor: pointer;
    text-align: left;
    padding: 0.3rem 0;
    transition: color 0.2s, font-weight 0.2s;
  }

  .filter-btn:hover,
  .filter-btn.active {
    color: var(--green);
    font-weight: 600;
  }

  .portfolio-grid {
    flex: 1;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .portfolio-item {
    aspect-ratio: 1;
    background: var(--green);
    border-radius: 1rem;
    overflow: hidden;
    transition: transform 0.25s, box-shadow 0.25s;
    cursor: pointer;
    position: relative;
  }

  .portfolio-item:hover {
    transform: scale(1.03);
    box-shadow: 0 12px 32px rgba(0,0,0,0.2);
  }

  .portfolio-item-label {
    position: absolute;
    bottom: 0; left: 0; right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.5));
    color: white;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 1rem 0.75rem 0.75rem;
    opacity: 0;
    transition: opacity 0.2s;
  }

  .portfolio-item:hover .portfolio-item-label { opacity: 1; }

  .portfolio-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portfolio-item-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: rgba(255,255,255,0.3);
    font-size: 0.75rem;
    text-align: center;
    padding: 1rem;
  }

  /* ── CONTACT ── */
  #contact {
    background: var(--pink);
    padding: 6rem 6rem;
    border-top: 1px solid var(--pink-dark);
  }

  #contact .section-title { color: var(--green); }
  #contact .section-title .accent { color: var(--green-light); font-style: italic; }

  .contact-wrapper {
    max-width: 520px;
    margin: 0 auto;
  }

  .contact-desc {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 0.9rem 1.25rem;
    border: 1.5px solid var(--pink-dark);
    border-radius: 0.75rem;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-size: 0.9rem;
    background: var(--white);
    color: var(--text);
    transition: border-color 0.2s;
    outline: none;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--green);
  }

  .contact-form textarea { resize: vertical; min-height: 120px; }

  .contact-form button {
    background: var(--green);
    color: var(--white);
    padding: 0.9rem 2rem;
    border-radius: 2rem;
    border: none;
    font-family: 'Plus Jakarta Sans', sans-serif;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .contact-form button:hover {
    background: var(--green-dark);
    transform: translateY(-2px);
  }

  .contact-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .contact-links a {
    font-size: 0.85rem;
    color: var(--green);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid var(--green-light);
    padding-bottom: 2px;
    transition: color 0.2s;
  }

  .contact-links a:hover { color: var(--green-dark); }

  /* footer */
  footer {
    background: var(--green-dark);
    color: rgba(255,255,255,0.4);
    text-align: center;
    padding: 1.5rem;
    font-size: 0.8rem;
  }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    #home { flex-direction: column; padding: 7rem 2rem 5rem; text-align: center; }
    .hero-photo { margin: 2rem auto 0; width: 220px; height: 260px; }
    .hero-buttons { justify-content: center; }
    #about, #portfolio, #contact { padding: 5rem 2rem; }
    .portfolio-layout { flex-direction: column; }
    .portfolio-filter { flex-direction: row; flex-wrap: wrap; gap: 0.5rem; }
    .hero-ticker { gap: 1rem; flex-wrap: wrap; justify-content: center; }
    nav { gap: 1rem; }
  }
</style>
</head>
<body>

<!-- NAV -->
<nav>
  <a href="#home" onclick="setActive(this)">About Me</a>
  <a href="#portfolio" onclick="setActive(this)">Skills</a>
  <a href="#contact" onclick="setActive(this)">Contact</a>
</nav>

<!-- HERO -->
<section id="home">
  <div class="hero-content">
    <p class="hero-greeting">Hi, I'm</p>
    <h1 class="hero-name">RIZKA SURNI<br>AULIA</h1>
    <p class="hero-sub">Mahasiswa Teknik Informatika</p>
    <div class="hero-buttons">
      <a href="#contact" class="btn-primary">Klik Here! 👋</a>
      <a href="#portfolio" class="btn-outline">Klik Me!</a>
    </div>
  </div>

  <div class="hero-photo">
    <!-- Ganti src dengan path foto kamu -->
    <!-- <img src="foto-rizka.jpg" alt="Rizka Surni Aulia"> -->
    <div class="hero-photo-placeholder">
      <img src="R.png" style="width: 85% ; object-fit: contain; image-rendering: scale(1.1); -webkit-optimize-contrast; crisp-edges;" >
    </div>
  </div>

  <div class="hero-ticker">
    <span>About Me</span>
    <span>About Me</span>
    <span>About Me</span>
    <span>About Me</span>
    <span>About Me</span>
    <span>About Me</span>
  </div>
</section>

<!-- ABOUT -->
<section id="about">
  <div class="reveal">
    <h2 class="section-title"><span class="accent">About</span> Me</h2>
    <p class="about-desc">Mahasiswa Teknik Informatika</p>
    <p class="about-sub">Mahasiswa Teknik Informatika</p>

    <h3 class="skills-title">Skills</h3>
    <div class="skills-grid">
      <div class="skill-pill">Administration</div>
      <div class="skill-pill">Editing</div>
      <div class="skill-pill">Manajemen Time</div>
      <div class="skill-pill">Organisation</div>
    </div>
  </div>
</section>

<!-- PORTFOLIO -->
<section id="portfolio">
  <div class="reveal">
    <h2 class="section-title"><span>Porto</span><span class="accent">folio</span></h2>
    <div class="portfolio-layout">

      <div class="portfolio-filter">
        <button class="filter-btn active" onclick="filterPortfolio('all', this)">All</button>
        <button class="filter-btn" onclick="filterPortfolio('administration', this)">Administration</button>
        <button class="filter-btn" onclick="filterPortfolio('editing', this)">Editing</button>
        <button class="filter-btn" onclick="filterPortfolio('manajemen', this)">Manajemen Time</button>
        <button class="filter-btn" onclick="filterPortfolio('organisasi', this)">Organisation</button>
      </div>

      <div class="portfolio-grid" id="portfolioGrid">
        <div class="portfolio-item" data-cat="administration">
          <div class="portfolio-item-placeholder">Proyek 1</div>
          <div class="portfolio-item-label">Administration</div>
        </div>
        <div class="portfolio-item" data-cat="editing">
          <div class="portfolio-item-placeholder">Proyek 2</div>
          <div class="portfolio-item-label">Editing</div>
        </div>
        <div class="portfolio-item" data-cat="manajemen">
          <div class="portfolio-item-placeholder">Proyek 3</div>
          <div class="portfolio-item-label">Manajemen Time</div>
        </div>
        <div class="portfolio-item" data-cat="organisasi">
          <div class="portfolio-item-placeholder">Proyek 4</div>
          <div class="portfolio-item-label">Organisation</div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- CONTACT -->
<section id="contact">
  <div class="reveal">
    <h2 class="section-title">Contact <span class="accent">Me</span></h2>
    <div class="contact-wrapper">
      <p class="contact-desc">Tertarik untuk bekerja sama atau sekadar menyapa? Kirim pesan ke aku yaa!</p>
      <div class="contact-form">
        <input type="text" placeholder="Nama kamu">
        <input type="email" placeholder="Email kamu">
        <textarea placeholder="Pesanmu..."></textarea>
        <button type="button">Send Message ✉️</button>
      </div>
      <div class="contact-links">
        <a href="https://www.instagram.com/rizkasurnia/">Instagram</a>
        <a href="https://www.facebook.com/share/1BLDWr2svs/">Facebook</a>
        <a href="https://www.tiktok.com/@rznouw?is_from_webapp=1&sender_device=pc/">Tiktok</a>
      </div>
    </div>
  </div>
</section>

<footer>
  © 2026 With Heart -- Rizka Surni Aulia.
</footer>

<script>
  // Active nav
  function setActive(el) {
    document.querySelectorAll('nav a').forEach(a => a.classList.remove('active'));
    el.classList.add('active');
  }

  // Update active nav on scroll
  const sections = document.querySelectorAll('section[id]');
  const navLinks = document.querySelectorAll('nav a');

  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(s => {
      if (window.scrollY >= s.offsetTop - 120) current = s.getAttribute('id');
    });
    navLinks.forEach(a => {
      a.classList.toggle('active', a.getAttribute('href') === '#' + current);
    });
  });

  // Scroll reveal
  const reveals = document.querySelectorAll('.reveal');
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
  }, { threshold: 0.15 });
  reveals.forEach(r => observer.observe(r));

  // Portfolio filter
  function filterPortfolio(cat, btn) {
    document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    document.querySelectorAll('.portfolio-item').forEach(item => {
      const match = cat === 'all' || item.dataset.cat === cat;
      item.style.display = match ? 'block' : 'none';
    });
  }
</script>
</body>
</html>
